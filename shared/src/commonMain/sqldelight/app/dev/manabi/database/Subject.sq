CREATE TABLE Subject (
    id INTEGER NOT NULL PRIMARY KEY,
    subjectName TEXT NOT NULL,
    conducted INTEGER NOT NULL,
    attended INTEGER NOT NULL,
    requirement INTEGER NOT NULL,
    days TEXT NOT NULL,
    teacher TEXT NOT NULL,
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL
);

getAllSubjects:
SELECT * FROM Subject;

insertSubject:
INSERT OR REPLACE INTO Subject(
    id,
    subjectName,
    conducted,
    attended,
    requirement,
    days,
    teacher,
    createdAt,
    updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSubject:
DELETE FROM Subject
WHERE id = ?;

deleteAllSubjects:
DELETE FROM Subject;
